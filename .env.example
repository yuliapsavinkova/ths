# .env.example
# Your Resend API key for sending email alerts on new booking requests
RESEND_API_KEY=

# The verified sender email address or domain configured in your Resend account (e.g. 'Yulia Sitting Service <onboarding@resend.dev>')
SITTER_EMAIL_FROM=

# The destination email address to receive booking request and subscriber alerts (e.g. 'yuliasavinkova@gmail.com')
SITTER_EMAIL_TO=
